{
  "name": "@d1g1tal/tsbuild",
  "author": "D1g1talEntr0py",
  "version": "2.2.3",
  "license": "MIT",
  "description": "A fast, ESM-only TypeScript build tool combining the TypeScript API for type checking and declaration generation with esbuild for bundling. Built for modern ESM-only projects on Node.js 22+.",
  "homepage": "https://github.com/D1g1talEntr0py/tsbuild#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D1g1talEntr0py/tsbuild.git"
  },
  "bugs": {
    "url": "https://github.com/D1g1talEntr0py/tsbuild/issues"
  },
  "maintainers": [
    {
      "name": "D1g1talEntr0py",
      "email": "jason.dimeo@gmail.com"
    }
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "packageManager": "pnpm@11.19.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "types": "./dist/type-script-project.d.ts",
  "exports": {
    ".": {
      "types": "./dist/type-script-project.d.ts",
      "import": "./dist/type-script-project.js"
    }
  },
  "files": [
    "./dist",
    "./schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "tsbuild": "./dist/tsbuild.js"
  },
  "scripts": {
    "build": "tsnode ./src/tsbuild.ts",
    "build:watch": "tsnode ./src/tsbuild.ts --watch",
    "bench": "tsnode ./tests/scripts/benchmark.ts",
    "type-check": "tsnode ./src/tsbuild.ts --noEmit",
    "lint": "eslint --flag unstable_native_nodejs_ts_config ./src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:compat": "tsnode tests/scripts/test-ts-compat.ts --versions 5"
  },
  "dependencies": {
    "@d1g1tal/watchr": "^1.1.1",
    "esbuild": "^0.28.1",
    "magic-string": "^1.1.0"
  },
  "devDependencies": {
    "@d1g1tal/tsnode": "^1.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-jsdoc": "^63.3.2",
    "fs-monkey": "^1.1.0",
    "memfs": "^4.64.0",
    "mitata": "^1.0.34",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "typescript": ">=5.6.3 < 7.0.0"
  },
  "keywords": [
    "typescript",
    "build",
    "bundler",
    "compiler",
    "type-checking",
    "library",
    "esbuild",
    "declarations",
    "dts",
    "esm"
  ]
}
